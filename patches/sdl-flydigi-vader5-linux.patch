+// Steam uses the extended HID interface for input. Send motor commands to the
+// separate Xbox endpoint through the local user service; never block input here.
+static bool SDL_HIDAPI_Flydigi_SendXboxRumble(Uint8 low, Uint8 high)
+{
+#ifdef SDL_PLATFORM_LINUX
+    struct sockaddr_un addr;
+    SDL_zero(addr);
+    addr.sun_family = AF_UNIX;
+    int name_length = SDL_snprintf(addr.sun_path + 1, sizeof(addr.sun_path) - 1,
+                                   "vader5-rumble-%lu", (unsigned long)getuid());
+    if (name_length < 0 || name_length >= (int)sizeof(addr.sun_path) - 1) {
+        return SDL_SetError("Rumble socket name is too long");
+    }
+    socklen_t addr_length = offsetof(struct sockaddr_un, sun_path) + 1 + name_length;
+    int fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (fd < 0) return SDL_SetError("Could not create rumble socket");
+    Uint8 motors[2] = {low, high};
+    int sent = sendto(fd, motors, sizeof(motors), MSG_DONTWAIT, (struct sockaddr *)&addr, addr_length);
+    close(fd);
+    if (sent != sizeof(motors)) return SDL_SetError("Xbox rumble bridge is unavailable");
+    return true;
+#else
+    return SDL_Unsupported();
+#endif
+}
